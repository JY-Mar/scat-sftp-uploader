{
  "name": "@scat1995/deployer",
  "version": "1.0.4",
  "description": "Web project deployer",
  "type": "module",
  "author": "JY-Mar",
  "license": "MIT",
  "homepage": "https://github.com/JY-Mar/scat-web-deployer#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/JY-Mar/scat-web-deployer.git"
  },
  "bugs": {
    "url": "https://github.com/JY-Mar/scat-web-deployer/issues"
  },
  "keywords": [
    "sftp-uploader",
    "web-deployer",
    "scientificat1995"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "types": "./dist/index.d.ts",
    "require": "./dist/index.cjs",
    "import": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsup",
    "link-g": "npm link",
    "unlink-g": "npm unlink @scat1995/deployer -g",
    "reinstall": "npm install",
    "publish-npmjs": "npm publish --access public",
    "publish-npmjs.beta": "npm publish --tag beta --access public"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "glob": "^13.0.6",
    "log-update": "^8.0.0",
    "ssh2-sftp-client": "^12.1.1",
    "unplugin": "^3.0.0"
  },
  "peerDependencies": {
    "rollup": ">=2.0.0",
    "vite": ">=2.0.0",
    "webpack": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "rollup": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/glob": "^9.0.0",
    "@types/node": "^24.3.0",
    "@types/ssh2-sftp-client": "^9.0.6",
    "rimraf": "^6.1.3",
    "terser": "^5.46.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.2"
  }
}
